{
    "name": "blyattebayo/polymorph-plugin-test-kit",
    "description": "Polymorph Extension SDK V2 test kit: in-memory fakes + PluginTestCase for extension unit tests.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "blyattebayo/polymorph-sdk": "^5.0",
        "blyattebayo/polymorph-sdk-laravel": "^5.0",
        "illuminate/container": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "phpunit/phpunit": "^11.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Polymorph\\Sdk\\Testing\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk-v2",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../sdk-laravel",
            "options": { "symlink": true }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
